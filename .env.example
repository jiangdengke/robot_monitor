ROBOT_MONITOR_IMAGE=ghcr.io/jiangdengke/robot-monitor:latest
ROBOT_MONITOR_PORT=7777

MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=project
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# Keep production safe by default: use `always` only for local demo database rebuilds.
SPRING_SQL_INIT_MODE=never
SPRING_SECURITY_LOG_LEVEL=info

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MIN=100
JWT_COOKIE_NAME=jwt

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Use classpath:... for bundled templates or file:/... for per-project deployment templates.
# Bundled examples: lounge-greeting, exhibition-guide.
PLATFORM_BOOTSTRAP_LOCATION=classpath:platform/templates/lounge-greeting/bootstrap.json
