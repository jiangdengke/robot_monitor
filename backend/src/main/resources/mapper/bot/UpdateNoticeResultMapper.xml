<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.robotmonitor.bot.mapper.UpdateNoticeResultMapper">
    <update id="updatePassengerWarningStatus">
        update passenger_warning_log
        set is_success = #{status},
            update_time = now()
        where robot_task_id = #{robotTaskId}
    </update>
</mapper>
