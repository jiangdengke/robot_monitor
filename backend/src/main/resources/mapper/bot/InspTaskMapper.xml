<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.robotmonitor.bot.mapper.InspTaskMapper">

    <resultMap type="InspTask" id="InspTaskResult">
        <result property="id"    column="id"    />
        <result property="robotId"    column="robot_id"    />
        <result property="status"    column="status"    />
        <result property="taskId"    column="task_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="endTime"    column="end_time"    />
    </resultMap>

    <sql id="selectInspTaskVo">
        select id, robot_id, status, task_id, create_time, end_time from insp_task
    </sql>

    <select id="selectInspTaskList" parameterType="InspTask" resultMap="InspTaskResult">
        <include refid="selectInspTaskVo"/>
        <where>
            <if test="robotId != null  and robotId != ''"> and robot_id = #{robotId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="taskId != null "> and task_id = #{taskId}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
        </where>
    </select>

    <select id="selectInspTaskById" parameterType="Long" resultMap="InspTaskResult">
        <include refid="selectInspTaskVo"/>
        where id = #{id}
    </select>

    <insert id="insertInspTask" parameterType="InspTask" useGeneratedKeys="true" keyProperty="id">
        insert into insp_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="robotId != null">robot_id,</if>
            <if test="status != null">status,</if>
            <if test="taskId != null">task_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="endTime != null">end_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="robotId != null">#{robotId},</if>
            <if test="status != null">#{status},</if>
            <if test="taskId != null">#{taskId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="endTime != null">#{endTime},</if>
        </trim>
    </insert>

    <update id="updateInspTask" parameterType="InspTask">
        update insp_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="robotId != null">robot_id = #{robotId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="taskId != null">task_id = #{taskId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteInspTaskById" parameterType="Long">
        delete from insp_task where id = #{id}
    </delete>

    <delete id="deleteInspTaskByIds" parameterType="String">
        delete from insp_task where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
