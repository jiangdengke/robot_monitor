<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.robotmonitor.config.mapper.ConfigDeviceMapper">

    <resultMap type="ConfigDevice" id="ConfigDeviceResult">
        <result property="id"    column="id"    />
        <result property="deviceName"    column="device_name"    />
        <result property="deviceType"    column="device_type"    />
        <result property="remark"    column="remark"    />
        <result property="enable"    column="enable"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="roomCode"    column="room_code"    />
        <result property="isDelete"    column="is_delete"    />
        <result property="deepGlintDeviceId"    column="deep_glint_device_id"    />
        <result property="deptName"    column="dept_name"    />
    </resultMap>

    <sql id="selectConfigDeviceVo">
        select a.id, a.device_name, a.device_type, a.remark, a.enable, a.create_by, a.create_time, a.update_by, a.update_time, a.room_code, a.is_delete, a.deep_glint_device_id,b.dept_name from config_device a
        left join sys_dept b on a.room_code=b.room_code
    </sql>

    <select id="selectConfigDeviceList" parameterType="ConfigDevice" resultMap="ConfigDeviceResult">
        <include refid="selectConfigDeviceVo"/>
        <where>
            <if test="deviceName != null  and deviceName != ''"> and a.device_name like concat('%', #{deviceName}, '%')</if>
            <if test="deviceType != null  and deviceType != ''"> and a.device_type = #{deviceType}</if>
            <if test="enable != null "> and a.enable = #{enable}</if>
            <if test="roomCode != null  and roomCode != ''"> and a.room_code = #{roomCode}</if>
            <if test="isDelete != null  and isDelete != ''"> and a.is_delete = #{isDelete}</if>
        </where>
    </select>

    <select id="selectConfigDeviceById" parameterType="Long" resultMap="ConfigDeviceResult">
        <include refid="selectConfigDeviceVo"/>
        where a.id = #{id}
    </select>

    <insert id="insertConfigDevice" parameterType="ConfigDevice">
        insert into config_device
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="deviceName != null">device_name,</if>
            <if test="deviceType != null">device_type,</if>
            <if test="remark != null">remark,</if>
            <if test="enable != null">enable,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="roomCode != null">room_code,</if>
            <if test="isDelete != null">is_delete,</if>
            <if test="deepGlintDeviceId != null">deep_glint_device_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="deviceName != null">#{deviceName},</if>
            <if test="deviceType != null">#{deviceType},</if>
            <if test="remark != null">#{remark},</if>
            <if test="enable != null">#{enable},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="roomCode != null">#{roomCode},</if>
            <if test="isDelete != null">#{isDelete},</if>
            <if test="deepGlintDeviceId != null">#{deepGlintDeviceId},</if>
         </trim>
    </insert>

    <update id="updateConfigDevice" parameterType="ConfigDevice">
        update config_device
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceName != null">device_name = #{deviceName},</if>
            <if test="deviceType != null">device_type = #{deviceType},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="enable != null">enable = #{enable},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="roomCode != null">room_code = #{roomCode},</if>
            <if test="isDelete != null">is_delete = #{isDelete},</if>
            <if test="deepGlintDeviceId != null">deep_glint_device_id = #{deepGlintDeviceId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteConfigDeviceById" parameterType="Long">
        delete from config_device where id = #{id}
    </delete>

    <delete id="deleteConfigDeviceByIds" parameterType="String">
        delete from config_device where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectConfigDeviceByDeepGlintDeviceId" parameterType="String" resultMap="ConfigDeviceResult">
        <include refid="selectConfigDeviceVo"/>
        where deep_glint_device_id = #{deepGlintDeviceId} and is_delete = '0'
    </select>

    <select id="selectExitDevices" resultMap="ConfigDeviceResult">
        <include refid="selectConfigDeviceVo"/>
        where device_name LIKE '%出口%' and is_delete = '0' and enable = 1
    </select>

</mapper>
