<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.robotmonitor.config.mapper.ConfigDeviceRegionMapper">
    
    <resultMap type="ConfigDeviceRegion" id="ConfigDeviceRegionResult">
        <result property="deviceId"    column="device_id"    />
        <result property="regionId"    column="region_id"    />
        <result property="imgId"    column="img_id"    />
        <result property="coordinate"    column="coordinate"    />
        <result property="regionName"    column="region_name"    />
        <result property="remark"    column="remark"    />
        <result property="img"    column="img"    />
    </resultMap>

    <sql id="selectConfigDeviceRegionVo">
        select device_id, region_id, img_id, coordinate from config_device_region
    </sql>

    <select id="selectConfigDeviceRegionList" parameterType="ConfigDeviceRegion" resultMap="ConfigDeviceRegionResult">
        <include refid="selectConfigDeviceRegionVo"/>
        <where>  
            <if test="imgId != null "> and img_id = #{imgId}</if>
            <if test="coordinate != null  and coordinate != ''"> and coordinate = #{coordinate}</if>
        </where>
    </select>
    
    <select id="selectConfigDeviceRegionByDeviceId" parameterType="Long" resultMap="ConfigDeviceRegionResult">
        select a.device_id, a.region_id, a.img_id, a.coordinate,b.region_name,b.remark,c.img from config_device_region a
                                                                                                      left join config_region b on a.region_id=b.id
                                                                                                      left join config_img c on c.id=a.img_id
        where a.device_id = #{deviceId}
        order by b.region_name
    </select>
    <select id="selectConfigDeviceRegionByDeviceIdRegionId" parameterType="Long" resultMap="ConfigDeviceRegionResult">
        select a.device_id, a.region_id, a.img_id, a.coordinate,b.region_name,b.remark,c.img from config_device_region a
                                                                                                      left join config_region b on a.region_id=b.id
                                                                                                      left join config_img c on c.id=a.img_id
        where a.device_id = #{deviceId}
        and a.region_id=#{regionId}
    </select>
        
    <insert id="insertConfigDeviceRegion" parameterType="ConfigDeviceRegion">
        insert into config_device_region
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">device_id,</if>
            <if test="regionId != null">region_id,</if>
            <if test="imgId != null">img_id,</if>
            <if test="coordinate != null">coordinate,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">#{deviceId},</if>
            <if test="regionId != null">#{regionId},</if>
            <if test="imgId != null">#{imgId},</if>
            <if test="coordinate != null">#{coordinate},</if>
         </trim>
    </insert>

    <update id="updateConfigDeviceRegion" parameterType="ConfigDeviceRegion">
        update config_device_region
        <trim prefix="SET" suffixOverrides=",">
            <if test="imgId != null">img_id = #{imgId},</if>
            <if test="coordinate != null">coordinate = #{coordinate},</if>
        </trim>
        where device_id = #{deviceId} and region_id = #{regionId}
    </update>

    <delete id="deleteConfigDeviceRegionByDeviceId" parameterType="Long">
        delete from config_device_region where device_id = #{deviceId}
    </delete>

    <delete id="deleteConfigDeviceRegion" parameterType="ConfigDeviceRegion">
        delete from config_device_region where device_id = #{deviceId} and region_id = #{regionId}

    </delete>

    <select id="selectByDeviceId" parameterType="Long" resultMap="ConfigDeviceRegionResult">
        <include refid="selectConfigDeviceRegionVo"/>
        where device_id = #{deviceId}
        order by region_id
    </select>
</mapper>