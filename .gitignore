# Keep the repository focused on the rebuilt admin project.
/*
!/.gitignore
!/README.md
!/backend/
!/frontend/
!/docs/

# Frontend build/runtime artifacts.
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.vite-temp/
frontend/*.local

# Legacy dist is no longer referenced — favicons moved to public/.
frontend/legacy-dist/

# Local/editor noise.
.local-backup/
.DS_Store
*.log

# backend build/runtime artifacts.
backend/.gradle/
backend/build/
