# Keep the repository focused on the rebuilt admin project.
/*
!/.gitignore
!/README.md
!/FRONTEND_REMAINING_PLAN.md
!/FULL_FUNCTION_IMPLEMENTATION_PLAN.md
!/FUNCTION_COMPARISON.md
!/MENU_ROUTE_MAPPING.md
!/backend/
!/frontend/
!/docs/

# Backend build/runtime artifacts.
backend/.gradle/
backend/build/
backend/runtime-config/
backend/logs/
backend/scripts/
backend/**/target/
backend/src/main/resources/**/*.class
backend/*.iml

# Frontend build/runtime artifacts.
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.vite-temp/
frontend/*.local

# Keep only the legacy assets that the rebuilt Vue app references directly.
frontend/legacy-dist/**
!frontend/legacy-dist/
!frontend/legacy-dist/favicon.ico
!frontend/legacy-dist/static/
!frontend/legacy-dist/static/jpg/
!frontend/legacy-dist/static/jpg/login-background-Yn3y1TP_.jpg

# Local/editor noise.
.local-backup/
.DS_Store
*.log
