    <sql id="selectPassengerVo">
        select id, user_name, room_code, flight_no, flight_date, orig, dest, cabin, seat, seq, card_service, card_no, mem_level, star_level, in_type, get_in_time, get_out_time, status, create_time, update_time, reid, pid, flight_id, region_id, ori_image_url, register_image_url, photo, robot_id, follower_num, is_member, colledt_id from passenger
    </sql>

    <select id="selectPassengerList" parameterType="Passenger" resultMap="PassengerResult">
        <include refid="selectPassengerVo"/>
        <where>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="roomCode != null  and roomCode != ''"> and room_code = #{roomCode}</if>
            <if test="flightNo != null  and flightNo != ''"> and flight_no = #{flightNo}</if>
            <if test="flightDate != null "> and flight_date = #{flightDate}</if>
            <if test="orig != null  and orig != ''"> and orig = #{orig}</if>
            <if test="dest != null  and dest != ''"> and dest = #{dest}</if>
            <if test="cabin != null  and cabin != ''"> and cabin = #{cabin}</if>
            <if test="seat != null  and seat != ''"> and seat = #{seat}</if>
            <if test="seq != null  and seq != ''"> and seq = #{seq}</if>
            <if test="cardService != null  and cardService != ''"> and card_service = #{cardService}</if>
            <if test="cardNo != null  and cardNo != ''"> and card_no = #{cardNo}</if>
            <if test="memLevel != null  and memLevel != ''"> and mem_level = #{memLevel}</if>
            <if test="starLevel != null  and starLevel != ''"> and star_level = #{starLevel}</if>
            <if test="inType != null  and inType != ''"> and in_type = #{inType}</if>
            <if test="getInTime != null "> and get_in_time = #{getInTime}</if>
            <if test="getOutTime != null "> and get_out_time = #{getOutTime}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="reid != null  and reid != ''"> and reid = #{reid}</if>
            <if test="pid != null  and pid != ''"> and pid = #{pid}</if>
            <if test="flightId != null  and flightId != ''"> and flight_id = #{flightId}</if>
        </where>
        order by create_time desc
    </select>
    <select id="selectPassengerList2" parameterType="PassengerParam" resultMap="PassengerResult">
        <include refid="selectPassengerVo"/>
        <where>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="roomCode != null  and roomCode != ''"> and room_code = #{roomCode}</if>
            <if test="flightNo != null  and flightNo != ''"> and flight_no = #{flightNo}</if>
            <if test="flightDate != null "> and flight_date = #{flightDate}</if>
            <if test="cardService != null  and cardService != ''"> and card_service = #{cardService}</if>
            <if test="cardNo != null  and cardNo != ''"> and card_no = #{cardNo}</if>
            <if test="memLevel != null  and memLevel != ''"> and mem_level = #{memLevel}</if>
            <if test="starLevel != null  and starLevel != ''"> and star_level = #{starLevel}</if>
            <if test="inType != null  and inType != ''"> and in_type = #{inType}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by get_in_time desc,get_out_time desc
    </select>

    <select id="selectPassengerList_Re" parameterType="Passenger" resultMap="PassengerResult">
        <include refid="selectPassengerVo"/>
        <where>
            <if test="userName != null  and userName != ''"> and user_name = #{userName}</if>
            <if test="flightNo != null  and flightNo != ''"> and flight_no = #{flightNo}</if>
            <if test="flightDate != null "> and flight_date = #{flightDate}</if>
            <if test="seat != null  and seat != ''"> and seat = #{seat}</if>
            <if test="flightId != null  and flightId != ''"> and flight_id = #{flightId}</if>
             and status=1
        </where>
    </select>

    <select id="selectPassengerById" parameterType="Long" resultMap="PassengerResult">
        <include refid="selectPassengerVo"/>
        where id = #{id}
    </select>

    <insert id="insertPassenger" parameterType="Passenger">
        insert into passenger
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userName != null">user_name,</if>
            <if test="roomCode != null">room_code,</if>
            <if test="flightNo != null">flight_no,</if>
            <if test="flightDate != null">flight_date,</if>
            <if test="orig != null">orig,</if>
            <if test="dest != null">dest,</if>
            <if test="cabin != null">cabin,</if>
            <if test="seat != null">seat,</if>
            <if test="seq != null">seq,</if>
            <if test="cardService != null">card_service,</if>
            <if test="cardNo != null">card_no,</if>
            <if test="memLevel != null">mem_level,</if>
            <if test="starLevel != null">star_level,</if>
            <if test="inType != null">in_type,</if>
            <if test="getInTime != null">get_in_time,</if>
            <if test="getOutTime != null">get_out_time,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="reid != null">reid,</if>
            <if test="pid != null">pid,</if>
            <if test="flightId != null  and flightId != ''"> flight_id,</if>
            <if test="robotId != null  and robotId != ''"> robot_id,</if>
            <if test="followerNum != null  and followerNum != ''"> follower_num,</if>
            <if test="isMember != null  and isMember != ''"> is_member,</if>
            <if test="colledtId != null">colledt_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userName != null">#{userName},</if>
            <if test="roomCode != null">#{roomCode},</if>
            <if test="flightNo != null">#{flightNo},</if>
            <if test="flightDate != null">#{flightDate},</if>
            <if test="orig != null">#{orig},</if>
            <if test="dest != null">#{dest},</if>
            <if test="cabin != null">#{cabin},</if>
            <if test="seat != null">#{seat},</if>
            <if test="seq != null">#{seq},</if>
            <if test="cardService != null">#{cardService},</if>
            <if test="cardNo != null">#{cardNo},</if>
            <if test="memLevel != null">#{memLevel},</if>
            <if test="starLevel != null">#{starLevel},</if>
            <if test="inType != null">#{inType},</if>
            <if test="getInTime != null">#{getInTime},</if>
            <if test="getOutTime != null">#{getOutTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="reid != null">#{reid},</if>
            <if test="pid != null">#{pid},</if>
