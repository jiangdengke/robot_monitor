    <update id="updatePassenger" parameterType="Passenger">
        update passenger
        <trim prefix="SET" suffixOverrides=",">
            <if test="userName != null">user_name = #{userName},</if>
            <if test="roomCode != null">room_code = #{roomCode},</if>
            <if test="flightNo != null">flight_no = #{flightNo},</if>
            <if test="flightDate != null">flight_date = #{flightDate},</if>
            <if test="orig != null">orig = #{orig},</if>
            <if test="dest != null">dest = #{dest},</if>
            <if test="cabin != null">cabin = #{cabin},</if>
            <if test="seat != null">seat = #{seat},</if>
            <if test="seq != null">seq = #{seq},</if>
            <if test="cardService != null">card_service = #{cardService},</if>
            <if test="cardNo != null">card_no = #{cardNo},</if>
            <if test="memLevel != null">mem_level = #{memLevel},</if>
            <if test="starLevel != null">star_level = #{starLevel},</if>
            <if test="inType != null">in_type = #{inType},</if>
            <if test="getInTime != null">get_in_time = #{getInTime},</if>
            <if test="getOutTime != null">get_out_time = #{getOutTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="reid != null">reid = #{reid},</if>
            <if test="pid != null">reid = #{pid},</if>
            <if test="flightId != null  and flightId != ''"> flight_id = #{flightId},</if>
            <if test="origImageUrl != null">ori_image_url = #{origImageUrl},</if>
            <if test="registerImageUrl != null">register_image_url = #{registerImageUrl},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="robotId != null  and robotId != ''">robot_id = #{robotId},</if>
            <if test="followerNum != null  and followerNum != ''"> follower_num=#{followerNum},</if>
            <if test="isMember != null  and isMember != ''"> is_member=#{isMember},</if>
            <if test="colledtId != null">colledt_id = #{colledtId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePassengerById" parameterType="Long">
        delete from passenger where id = #{id}
    </delete>

    <delete id="deletePassengerByIds" parameterType="String">
        delete from passenger where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <update id="setPassengerGetOut" parameterType="String">
        update passenger
        <trim prefix="SET" suffixOverrides=",">
            status = '0',get_out_time = now(),ori_image_url=#{oriImgUrl},region_id=#{regionId}
        </trim>
        where id = #{id}
    </update>

    <update id="updatePassengerRegionAndStatus" parameterType="map">
        update passenger
        <trim prefix="SET" suffixOverrides=",">
            region_id = #{regionId},
            ori_image_url = #{origImageUrl},
            register_image_url = #{registerImageUrl},
            status = #{status},
            get_out_time= null,
            update_time = now()
        </trim>
        where id = #{id}
    </update>

    <select id="selectPassengerWithUnflownFlights" resultMap="PassengerResult">
        select p.* from passenger p
                            inner join flight_info f on p.flight_id = f.flight_id
        where (f.latest_off_status = 'SCH' or f.latest_off_status = 'ETD')
    </select>

    <select id="selectPassengerOutgoingList" parameterType="Passenger" resultMap="PassengerResult">
        select p.* from passenger p
        where p.status = '0'
        <if test="userName != null and userName != ''">
            and p.user_name like concat('%', #{userName}, '%')
        </if>
        <if test="flightNo != null and flightNo != ''">
            and p.flight_no = #{flightNo}
        </if>
        <if test="flightDate != null">
            and p.flight_date = #{flightDate}
        </if>
        <if test="getOutTimeStart != null">
            and p.get_out_time &gt;= #{getOutTimeStart}
        </if>
        <if test="getOutTimeEnd != null">
            and p.get_out_time &lt;= #{getOutTimeEnd}
        </if>
        <if test="orig != null and orig != ''">
            and p.orig = #{orig}
        </if>
        <if test="dest != null and dest != ''">
            and p.dest = #{dest}
        </if>
        order by p.get_out_time desc
    </select>

    <select id="selectPassengerInLoungeList" parameterType="Passenger" resultMap="PassengerWithCoordinateResult">
        select * from passenger p
        inner join flight_info f on p.flight_id = f.flight_id
        where p.status = '1' and (f.latest_off_status = 'SCH' or f.latest_off_status = 'ETD' or f.latest_off_status = 'CLD' or f.latest_off_status = 'OUT')
          and get_in_time >CURRENT_DATE
        <if test="userName != null and userName != ''">
            and p.user_name like concat('%', #{userName}, '%')
        </if>
        <if test="flightNo != null and flightNo != ''">
            and p.flight_no = #{flightNo}
        </if>
        <if test="flightDate != null">
            and p.flight_date = #{flightDate}
        </if>
        <if test="orig != null and orig != ''">
            and p.orig = #{orig}
        </if>
        <if test="dest != null and dest != ''">
            and p.dest = #{dest}
        </if>
        <if test="roomCode != null and roomCode != ''">
            and p.room_code = #{roomCode}
        </if>
        order by p.update_time desc
    </select>

    <update id="updatePassengerCheckoutStatus" parameterType="map">
        update passenger
        <trim prefix="SET" suffixOverrides=",">
            status = #{status},
            get_out_time = now(),
            ori_image_url = #{origImageUrl},
            register_image_url = #{registerImageUrl}
        </trim>
        where pid = #{pId}
    </update>

    <select id="selectPassengerByPid" parameterType="String" resultMap="PassengerResult">
        <include refid="selectPassengerVo"/>
        where pid = #{pid} and create_time>=CURDATE()
        order by create_time desc
        limit 1
    </select>

    <select id="selectPassengerByReid" parameterType="String" resultMap="PassengerResult">
        <include refid="selectPassengerVo"/>
        where reid = #{reid}
        order by create_time desc
        limit 1
    </select>

    <resultMap id="FlightChangePassengerResult" type="FlightChangePassengerDTO">
        <result property="id"    column="id"    />
        <result property="userName"    column="user_name"    />
        <result property="roomCode"    column="room_code"    />
        <result property="flightNo"    column="flight_no"    />
        <result property="flightDate"    column="flight_date"    />
        <result property="flightId"    column="flight_id"    />
        <result property="origImageUrl"    column="ori_image_url"    />
        <result property="registerImageUrl"    column="register_image_url"    />
        <result property="orig"    column="orig"    />
        <result property="dest"    column="dest"    />
        <result property="cabin"    column="cabin"    />
        <result property="getInTime"    column="get_in_time"    />
        <result property="getOutTime"    column="get_out_time"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="regionId"    column="region_id"    />
        <result property="regionName" column="region_name"  />
        <result property="remark" column="remark"  />
        <result property="coordinate"    column="coordinate"    />
        <result property="warningType"    column="warning_type"    />
        <result property="warningType"    column="warning_type"    />
        <result property="changeBefore"    column="change_before"    />
        <result property="changeAfter"    column="change_after"    />
    </resultMap>

    <select id="selectPassengerWithFlightChangeList" parameterType="Passenger" resultMap="FlightChangePassengerResult">
        select
            p.id,
            p.user_name,
            p.room_code,
            p.flight_no,
            p.flight_date,
            p.flight_id,
            p.ori_image_url,
            p.register_image_url,
            p.orig,
            p.dest,
            p.cabin,
            p.get_in_time,
            p.get_out_time,
            p.status,
            p.create_time,
            p.update_time,
            p.region_id,
            r.coordinate,
            r.region_name,
            r.remark,
            fw.warning_type,
            fw.change_before,
            fw.change_after
        from passenger p
        inner join flight_warning fw on p.flight_id = fw.flight_id
        left join config_region r on p.region_id = r.id
        <where>
            <if test="userName != null  and userName != ''"> and p.user_name like concat('%', #{userName}, '%')</if>
            <if test="flightId != null  and flightId != ''"> and p.flight_id = #{flightId}</if>
            <if test="flightNo != null  and flightNo != ''"> and p.flight_no = #{flightNo}</if>
            <if test="warningType != null  and warningType != ''"> and fw.warning_type = #{warningType}</if>
        </where>
        order by p.create_time desc
    </select>

</mapper>
