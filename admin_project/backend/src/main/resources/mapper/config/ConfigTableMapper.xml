<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.robotmonitor.config.mapper.ConfigTableMapper">

    <resultMap type="ConfigTable" id="ConfigTableResult">
        <result property="id"    column="id"    />
        <result property="tableNo"    column="table_no"    />
        <result property="regionId"    column="region_id"    />
        <result property="roomCode"    column="room_code"    />
        <result property="isEnable"    column="is_enable"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="deviceId"    column="device_id"    />
        <result property="cameraCoordinates"    column="camera_coordinates"    />
        <result property="deptName"    column="dept_name"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectConfigTableVo">
        select a.id, a.table_no, a.region_id, a.room_code, a.is_enable, a.remark, a.create_by, a.create_time, a.update_by, a.update_time, a.device_id, a.camera_coordinates,b.dept_name,a.status
        from config_table a
                 left join sys_dept b on a.room_code=b.room_code
    </sql>

    <select id="selectConfigTableList" parameterType="ConfigTable" resultMap="ConfigTableResult">
        <include refid="selectConfigTableVo"/>
        <where>
            <if test="tableNo != null  and tableNo != ''"> and a.table_no = #{tableNo}</if>
            <if test="regionId != null "> and a.region_id = #{regionId}</if>
            <if test="roomCode != null  and roomCode != ''"> and a.room_code = #{roomCode}</if>
            <if test="isEnable != null  and isEnable != ''"> and a.is_enable = #{isEnable}</if>
            <if test="deviceId != null "> and a.device_id = #{deviceId}</if>
            <if test="cameraCoordinates != null  and cameraCoordinates != ''"> and camera_coordinates = #{cameraCoordinates}</if>
            <if test="status != null "> and a.status = #{status}</if>
        </where>
    </select>

    <select id="selectConfigTableById" parameterType="Long" resultMap="ConfigTableResult">
        <include refid="selectConfigTableVo"/>
        where a.id = #{id}
    </select>

    <insert id="insertConfigTable" parameterType="ConfigTable" useGeneratedKeys="true" keyProperty="id">
        insert into config_table
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tableNo != null">table_no,</if>
            <if test="regionId != null">region_id,</if>
            <if test="roomCode != null">room_code,</if>
            <if test="isEnable != null">is_enable,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="deviceId != null">device_id,</if>
            <if test="cameraCoordinates != null">camera_coordinates,</if>
            <if test="status != null">status,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tableNo != null">#{tableNo},</if>
            <if test="regionId != null">#{regionId},</if>
            <if test="roomCode != null">#{roomCode},</if>
            <if test="isEnable != null">#{isEnable},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="deviceId != null">#{deviceId},</if>
            <if test="cameraCoordinates != null">#{cameraCoordinates},</if>
            <if test="status != null">#{status},</if>
        </trim>
    </insert>

    <update id="updateConfigTable" parameterType="ConfigTable">
        update config_table
        <trim prefix="SET" suffixOverrides=",">
            <if test="tableNo != null">table_no = #{tableNo},</if>
            <if test="regionId != null">region_id = #{regionId},</if>
            <if test="roomCode != null">room_code = #{roomCode},</if>
            <if test="isEnable != null">is_enable = #{isEnable},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="cameraCoordinates != null">camera_coordinates = #{cameraCoordinates},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteConfigTableById" parameterType="Long">
        delete from config_table where id = #{id}
    </delete>

    <delete id="deleteConfigTableByIds" parameterType="String">
        delete from config_table where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <update id="setTableStatus" parameterType="ConfigTable">
        update config_table
        set status = #{status}
        where id = #{id}
    </update>
</mapper>